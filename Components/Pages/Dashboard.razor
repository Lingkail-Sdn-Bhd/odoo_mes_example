                <MudPaper Class="pa-4" Style="@CardStyle">
                    <MudText Style="@LabelStyle">
                        Mixer RPM
                    </MudText>
                    <MudText Typo="Typo.h5" Style="@ValueStyle">
                        @rpm rpm
