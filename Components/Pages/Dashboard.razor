@code {
    private int rpm = 287;
    private double torque = 12.8;
    private double temperature = 38.0;
    private double vacuum = -95.5;
    private double humidity = 55.0;

    private bool isSendingCps = false;
    private bool cpsSuccess = false;
    private string cpsResponse = "";

    [Inject]
    private IHttpClientFactory HttpClientFactory { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private async Task SendCpsData()
    {
        isSendingCps = true;
        cpsSuccess = false;
        cpsResponse = "";

        try
        {
            var sensorData = new 
            {
                rpm,
                torque,
                temperature,
                vacuum
            };

            using var client = HttpClientFactory.CreateClient();
            client.BaseAddress = new Uri(Navigation.BaseUri);

            using var response =
                await client.PostAsJsonAsync(
                    "api/sensor",
                    sensorData);

            var result =
                await response.Content.ReadAsStringAsync();

            cpsSuccess = response.IsSuccessStatusCode;

            if (cpsSuccess)
            {
                cpsResponse = "SUCCESS! CPS data sent to local API. " + result;
            }
            else
            {
                cpsResponse = "FAILED! " + result;
            }
        }
        catch (Exception ex)
        {
            cpsSuccess = false;
            cpsResponse = "ERROR: " + ex.Message;
        }
        finally
        {
            isSendingCps = false;
        }
    }

    private async Task PreviewCpsToOdoo()
    {
        isSendingCps = true;
        cpsSuccess = false;
        cpsResponse = "";

        try
        {
            var data = new
            {
                rpm,
                torque,
                temperature,
                vacuum
            };

            using var client = HttpClientFactory.CreateClient();
            client.BaseAddress = new Uri(Navigation.BaseUri);

            using var response = await client.PostAsJsonAsync(
                "api/cps-odoo-preview",
                data);

            var result =
                await response.Content.ReadAsStringAsync();

            cpsSuccess = response.IsSuccessStatusCode;

            if (cpsSuccess)
            {
                cpsResponse = "SUCCESS! " + result;
            }
            else
            {
                cpsResponse = "FAILED! " + result;
            }
        }
        catch (Exception ex)
        {
            cpsSuccess = false;
            cpsResponse = "ERROR: " + ex.Message;
        }
        finally
        {
            isSendingCps = false;
        }
    }


    private PeriodicTimer? timer;
    private CancellationTokenSource? cancellation;
    private Task? simulationTask;

    private string CardStyle =
        "background:#071e2e; border:1px solid #086c8c; border-radius:12px;";

    private string LabelStyle =
        "color:#9ddfff; font-size:12px;";

    private string ValueStyle =
       "color:#22e6c1; font-weight:bold;";

    private string FiveCStyle =
        "background:#082a3b;" +
        "border:1px solid #086c6c;" +
        "border-radius:10px;" +
        "text-align:center;" +
        "min-height:95px;";

    private string FiveCTitleStyle =
        "color:#36dcff;" +
        "font-size:16px;" +
        "font-weight:bold;";

    private string FiveCTextStyle =
        "color:#d7f5ff;" +
        "font-size:13px;" +
        "margin-top:6px;";


    protected override void OnInitialized()
    {
        cancellation = new CancellationTokenSource();
        timer = new PeriodicTimer(
            TimeSpan.FromSeconds(1));

        simulationTask = RunSimulationAsync(
            cancellation.Token);
    }

    private async Task RunSimulationAsync(
        CancellationToken token)
    {
        try
        {
            while (timer != null &&
                  await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(async () =>
                {
                    rpm = 287 + Random.Shared.Next(-5, 6);

                    torque = 12.8 +
                       (Random.Shared.NextDouble() - 0.5);

                    temperature = 38.0 +
                        (Random.Shared.NextDouble() - 0.5);

                    vacuum = -95.5 +
                        (Random.Shared.NextDouble() - 0.5);

                    viscosity = 46000 +
                        (Random.Shared.NextDouble() - 0.5) * 600;

                    exothermRate = Math.Clamp(
                        exothermRate +
                        (Random.Shared.NextDouble() - 0.5) * 0.08,
                        1.1,
                        1.8
                    );

                    humidity = 55.0 +
                        (Random.Shared.NextDouble() * 15);

                    elapsedSeconds++;

                    // Keep only the latest 30 readings
                    if (mixerHistory.Count > 30)
                    {
                        mixerHistory.RemoveAt(0);
                    }

                    StateHasChanged();

                    if (mixerChart != null)
                    {
                        await mixerChart.UpdateSeriesAsync();
                    }

                    if (vacuumChart != null)
                    {
                        await vacuumChart.UpdateSeriesAsync();
                    }

                    if (viscosityChart != null)
                    {
                        await viscosityChart.UpdateSeriesAsync();
                    }

                    if (exothermChart != null)
                    {
                        await exothermChart.UpdateSeriesAsync();
                    }

                    if (torqueChart != null)
                    {
                        await torqueChart.UpdateSeriesAsync();
                    }

                    if (temperatureChart != null)
                    {
                        await temperatureChart.UpdateSeriesAsync();
                    }

                    mixerHistory.Add(new MixerPoint
                    {
                        Second = elapsedSeconds,
                        CurrentRpm = rpm,
                        GoldenRpm = 287,
                        AbnormalRpm = 287 + Math.Min(elapsedSeconds * 0.5, 80)
                    });

                    vacuumHistory.Add(new VacuumPoint
                        {
                            Second = elapsedSeconds,
                            CurrentVacuum = vacuum,
                            GoldenVacuum = -95.5,

                            AbnormalVacuum = -95.5 +
                                4.0 * Math.Exp(-elapsedSeconds / 25.0)
                        });

                    if (vacuumHistory.Count > 30)
                    {
                        vacuumHistory.RemoveAt(0);
                    }

                    viscosityHistory.Add(new ViscosityPoint
                        {
                            Second = elapsedSeconds,
                            CurrentViscosity = viscosity,
                            GoldenViscosity = 48000,
                        });

                    if (viscosityHistory.Count > 30)
                    {
                        viscosityHistory.RemoveAt(0);
                    }

                    exothermHistory.Add(new ExothermPoint
                        {
                            Second = elapsedSeconds,
                            CurrentRate = exothermRate,
                            GoldenRate = 0.25,
                            AlarmThreshold = 3.0
                        });

                    if (exothermHistory.Count > 30)
                    {
                        exothermHistory.RemoveAt(0);
                    }

                    torqueHistory.Add(new TorquePoint
                    {
                        Second = elapsedSeconds,
                        CurrentTorque = torque,
                        GoldenTorque = 10.0
                    });

                    temperatureHistory.Add(new TemperaturePoint
                        {
                            Second = elapsedSeconds,
                            CurrentTemperature = temperature,
                            GoldenTemperature = 32.0
                        });

                    if (temperatureHistory.Count > 30)
                    {
                        temperatureHistory.RemoveAt(0);
                    }

                });
            }
        }
        catch (OperationCanceledException)
        {
            //Expected when leaving the dashboard
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (cancellation != null)
        {
            await cancellation.CancelAsync();
        }

        if (simulationTask != null)
        {
            await simulationTask;
        }

        timer?.Dispose();
        cancellation?.Dispose();
    }

