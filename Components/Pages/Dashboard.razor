@page "/dashboard"
@layout DashboardLayout
@using MudBlazor
@using ApexCharts
@using System.Net.Http.Json
@implements IAsyncDisposable

<PageTitle>Chemical Formulation Cyber-Physical System (CPS)</PageTitle>

<div style="background:#061724";
            min-height:100vh;
            padding:20px;
            color:white;'>
        
