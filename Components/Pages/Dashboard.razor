                </MudPaper>
         
                <MudPaper Class="pa-4" Style="@CardStyle">
                    <MudText Style="@LabelStyle">
                        TORQUE
                    </MudText>
                    <MudText Typo="Typo.h5" Style="@ValueStyle">
                    @torque.ToString("F1") Nm
                </MudText>
                </MudPaper>
 
                <MudPaper Class="pa-4" Style="@CardStyle">
                    <MudText Style="@LabelStyle">
                        TEMPERATURE
                    </MudText>
                    <MudText Typo="Typo.h5" Style="@ValueStyle">
                        @temperature.ToString("F1") °C
                    </MudText>
                </MudPaper>
        
                <MudPaper Class="pa-4" Style="@CardStyle">
                    <MudText Style="@LabelStyle">
                        VACUUM
                    </MudText>
                    <MudText Typo="Typo.h5" Style="@ValueStyle">
                        @vacuum.ToString("F1") kPa
                    </MudText>
                </MudPaper>
     
                <MudPaper Class="pa-4" Style="@CardStyle">
                    <MudText Style="@LabelStyle">
                        HUMIDITY
                    </MudText>
                    <MudText Typo="Typo.h5" Style="@ValueStyle">
                        @humidity.ToString("F1") %
                    </MudText>
                </MudPaper>
        </div>

        <MudButton Variant="Variant.Filled"
