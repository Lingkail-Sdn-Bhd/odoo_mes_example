                  Style="background:#08344b";
                         padding:25px;
                         border-radius:0;">
                     
             <MudText Typo="Typo.h4"        
                      Style="color:#e5f5ff;
                             font-weight:bold;">
                 Chemical Formulation Cyber-Physical System (CPS)        
             </MudText>

             <MudText Style="color:#5cddff;">
                 High-Precision Optical Resin Mixing &amp;
                 Vacuum Degassing - simulated data for presentation
