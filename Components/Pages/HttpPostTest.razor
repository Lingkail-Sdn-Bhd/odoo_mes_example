@page "/http-post-test"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using MudBlazor
@inject NavigationManager Navigation

<PageTitle>HTTP POST Testing</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">

    <MudText Typo="Typo.h4" Class="mb-2">
        HTTP POST Testing
    </MudText>

    <MudText Typo="Typo.body2"
             Color="Color.Secondary"
             Class="mb-5">
        CPS Sensor Data - API Integration
    </MudText>

    <MudPaper Class="pa-5 mb-4" Elevation="2">

        <MudText Typo="Typo.h6" Class="mb-4">
            Sensor Data
        </MudText>

        <MudGrid Spacing="3">

            <MudItem xs="12" sm="6">
                <MudNumericField T="double"
                                 Label="Temperature (°C)"
                                 @bind-Value="temperature"
                                 Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudNumericField T="double"
                                 Label="Humidity (%)"
                                 @bind-Value="humidity"
                                 Variant="Variant.Outlined" />
            </MudItem>

        </MudGrid>

        <MudStack Row="true"
                  Spacing="2"
                  Class="mt-5"
                  FlexWrap="Wrap.Wrap">

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@isSending"
                       OnClick="TestLocalApi">
                Test Local API
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       Disabled="@isSending"
                       OnClick="TestOdooConnection">
                Test Odoo Connection
            </MudButton>

        </MudStack>

    </MudPaper>

    <MudPaper Class="pa-5" Elevation="2">

        <MudText Typo="Typo.h6" Class="mb-3">
            API Response
        </MudText>

        @if (isSending)
        {
            <MudProgressLinear Indeterminate="true"
                               Color="Color.Primary"
                               Class="mb-3" />
        }

        @if (!string.IsNullOrWhiteSpace(lastRequest))
        {
            <MudText Typo="Typo.body2" Class="mb-2">
                <b>Request:</b> @lastRequest
            </MudText>
        }

        @if (!string.IsNullOrWhiteSpace(responseMessage))
        {
            <MudAlert Severity="@(requestSucceeded
                                      ? Severity.Success
                                      : Severity.Error)"
                      Variant="Variant.Outlined">

                <div style="overflow-wrap:anywhere;
                    white-space:pre-wrap;">
                    @responseMessage
                </div>

            </MudAlert>
        }
        else
        {
            <MudText Color="Color.Secondary">
                No request sent yet.
            </MudText>
        }

    </MudPaper>

</MudContainer>

@code {

    private double temperature = 28.0;
    private double humidity = 65.0;

    private bool isSending = false;
    private bool requestSucceeded = false;

    private string lastRequest = "";
    private string responseMessage = "";

    private async Task TestLocalApi()
    {
        lastRequest = "POST /api/sensor";

        await SendRequest(
            "api/sensor",
            new
            {
                temperature,
                humidity
            });
    }

    private async Task TestOdooConnection()
    {
        lastRequest = "POST /api/odoo-test";

        await SendRequest("api/odoo-test");
    }

    private async Task SendRequest(
        string endpoint,
        object? data = null)
    {
        isSending = true;
        requestSucceeded = false;
        responseMessage = "";

        try
        {
            using var client = new HttpClient
            {
                BaseAddress = new Uri(Navigation.BaseUri)
            };

            using var response =
                await client.PostAsJsonAsync(
                    endpoint,
                    data ?? new { });

            var result =
                await response.Content.ReadAsStringAsync();

            requestSucceeded = response.IsSuccessStatusCode;

            if (requestSucceeded)
            {
                try
                {
                    using var json =
                        System.Text.Json.JsonDocument.Parse(result);

                    if (json.RootElement.TryGetProperty(
                            "success", out var successValue)
                        && successValue.ValueKind ==
                           System.Text.Json.JsonValueKind.False)
                    {
                        requestSucceeded = false;
                    }
                }
                catch (System.Text.Json.JsonException)
                {
                    // Non-JSON responses use HTTP status.
                }
            }

            responseMessage =
                (requestSucceeded ? "SUCCESS!\n" : "FAILED!\n")
                + result;
        }
        catch (Exception ex)
        {
            requestSucceeded = false;
            responseMessage =
                "ERROR: " + ex.Message;
        }
        finally
        {
            isSending = false;
        }
    }
}
